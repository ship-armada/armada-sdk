{
  "name": "@armada/sdk",
  "version": "0.0.0",
  "description": "Fork-and-shrink replacement of the Railgun SDK stack for the Armada protocol",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "SPEC.md",
    "NOTICE.md",
    "vendor/railgun-engine/LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core/index.d.ts"
      ],
      "wallet": [
        "./dist/wallet/index.d.ts"
      ],
      "payments": [
        "./dist/payments/index.d.ts"
      ],
      "ops": [
        "./dist/ops/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./wallet": {
      "import": {
        "types": "./dist/wallet/index.d.ts",
        "default": "./dist/wallet/index.js"
      },
      "require": {
        "types": "./dist/wallet/index.d.cts",
        "default": "./dist/wallet/index.cjs"
      }
    },
    "./prover": {
      "import": {
        "types": "./dist/prover/index.d.ts",
        "default": "./dist/prover/index.js"
      },
      "require": {
        "types": "./dist/prover/index.d.cts",
        "default": "./dist/prover/index.cjs"
      }
    },
    "./prover/worker": {
      "import": {
        "types": "./dist/prover/worker.d.ts",
        "default": "./dist/prover/worker.js"
      },
      "require": {
        "types": "./dist/prover/worker.d.cts",
        "default": "./dist/prover/worker.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      }
    }
  },
  "scripts": {
    "build:vendor": "tsc -p vendor/railgun-engine/tsconfig.build.json && node scripts/postbuild-vendor.mjs",
    "prebuild": "npm run build:vendor",
    "build": "tsup",
    "prepare": "npm run build",
    "pretypecheck": "npm run build:vendor",
    "typecheck": "tsc --noEmit",
    "typecheck:vendor": "tsc -p vendor/railgun-engine/tsconfig.json",
    "pretest": "npm run build:vendor",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vectors": "vitest run test/vectors",
    "lint": "eslint . --ext .ts",
    "predocs:api": "npm run build:vendor",
    "docs:api": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@noble/ciphers": "^0.4.0",
    "@noble/ed25519": "^1.7.1",
    "@noble/hashes": "^1.3.2",
    "@railgun-community/circomlibjs": "0.0.8",
    "@railgun-community/curve25519-scalarmult-wasm": "0.1.5",
    "@railgun-community/poseidon-hash-wasm": "1.0.1",
    "@scure/base": "^1.1.1",
    "assert": "^2.1.0",
    "buffer-xor": "^2.0.2",
    "ethereum-cryptography": "^2.0.0",
    "ethers": "^6.14.3",
    "fast-text-encoding": "^1.0.6",
    "msgpack-lite": "^0.1.26",
    "snarkjs": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "eslint": "^8.57.0",
    "fake-indexeddb": "^6.2.5",
    "memory-level": "^3.1.0",
    "mermaid": "^11.17.2",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^5.4.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^1.6.0"
  }
}
